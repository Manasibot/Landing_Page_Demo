# Copy this file to .env.local (Next.js does NOT load .env.example).
# Then the app will use these values.

# Invitation form: Calendly embed (replace with your Calendly scheduling page)
NEXT_PUBLIC_CALENDLY_EMBED_URL=https://calendly.com/clictohire/30min

# ---- Google Sheets (choose one option) ----

# Option A: Direct Sheets API (recommended)
# 1. Create a Google Cloud project, enable Google Sheets API, create a Service Account, download JSON key.
# 2. Create a Google Sheet, share it with the service account email as Editor.
# 3. Copy the Sheet ID from the URL: https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
#
# Credentials: use EITHER a file path (easiest) OR the raw JSON string.
# - File path (recommended): put the key file in the project, then set:
GOOGLE_SHEET_ID=
GOOGLE_APPLICATION_CREDENTIALS=./google-service-account.json
# - Or paste minified JSON on one line (no line breaks):
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
#
# GOOGLE_SHEET_NAME=Sheet1

# Option B: Webhook (Google Apps Script)
# Deploy a Web App from your sheet (see docs/google-sheets-setup.md or scripts/google-apps-script.js), then set:
# INVITATION_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec
# INVITATION_WEBHOOK_URL=
